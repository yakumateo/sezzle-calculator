@startuml
title <size:24>Container View: Sezzle Calculator</size>\n<size:24>The Web Application delivers the SPA and proxies its calls to the Calculator API.</size>

set separator none
left to right direction

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Container>

AddElementTag("Container,WebServer", $bgColor="#2e7cb8", $borderColor="#205680", $fontColor="#ffffff", $sprite="", $shadowing="", $borderStyle="solid")
AddElementTag("Container,API", $bgColor="#17607f", $borderColor="#104358", $fontColor="#ffffff", $sprite="", $shadowing="", $borderStyle="solid")
AddElementTag("Container,SPA", $bgColor="#1168bd", $borderColor="#0b4884", $fontColor="#ffffff", $sprite="", $shadowing="", $borderStyle="solid")
AddElementTag("Person,Developer", $bgColor="#5a6b7f", $borderColor="#3e4a58", $fontColor="#ffffff", $sprite="", $shadowing="", $borderStyle="solid")
AddElementTag("Person,User", $bgColor="#0b5f8a", $borderColor="#074260", $fontColor="#ffffff", $sprite="", $shadowing="", $borderStyle="solid")

AddRelTag("Relationship", $textColor="#666666", $lineColor="#666666", $lineStyle = DashedLine())

AddBoundaryTag("Software System,Platform", $bgColor="#ffffff", $borderColor="#096440", $fontColor="#096440", $shadowing="", $borderStyle="solid")

Person(User, "User", $descr="Performs calculations in a web browser, on desktop or mobile.", $tags="Person,User", $link="")
Person(APIConsumer, "API Consumer", $descr="Developer who calls the REST API directly or explores it in Swagger UI.", $tags="Person,Developer", $link="")

System_Boundary("SezzleCalculator_boundary", "Sezzle Calculator", $tags="Software System,Platform") {
  Container(SezzleCalculator.CalculatorAPI, "Calculator API", $techn="Go 1.27, net/http", $descr="Exposes one REST endpoint per operation, validates every request and documents itself with OpenAPI.", $tags="Container,API", $link="")
  Container(SezzleCalculator.WebApplication, "Web Application", $techn="nginx 1.28", $descr="Delivers the static content and the single-page application to the browser, and proxies /api and /docs to the API.", $tags="Container,WebServer", $link="")
  Container(SezzleCalculator.SinglePageApplication, "Single-Page Application", $techn="TypeScript, React 19", $descr="Lets the user enter numbers, choose an operation and see the result.", $tags="Container,SPA", $link="")
}

Rel(User, SezzleCalculator.WebApplication, "Visits the calculator at", $techn="HTTP", $tags="Relationship", $link="")
Rel(User, SezzleCalculator.SinglePageApplication, "Enters numbers and reads the results in", $techn="Web UI", $tags="Relationship", $link="")
Rel(APIConsumer, SezzleCalculator.WebApplication, "Calls the REST API and opens Swagger UI at", $techn="JSON / HTTP", $tags="Relationship", $link="")
Rel(SezzleCalculator.WebApplication, SezzleCalculator.SinglePageApplication, "Delivers the application to the user's browser", $techn="HTTP", $tags="Relationship", $link="")
Rel(SezzleCalculator.SinglePageApplication, SezzleCalculator.WebApplication, "Sends calculation requests to /api at", $techn="JSON / HTTP", $tags="Relationship", $link="")
Rel(SezzleCalculator.WebApplication, SezzleCalculator.CalculatorAPI, "Forwards /api and /docs requests to (reverse proxy)", $techn="HTTP", $tags="Relationship", $link="")

SHOW_LEGEND(true)
hide stereotypes
@enduml