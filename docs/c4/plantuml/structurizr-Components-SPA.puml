@startuml
title <size:24>Component View: Sezzle Calculator - Single-Page Application</size>\n<size:24>Single-page application by layer: presentation, state, domain and API client.</size>

set separator none
left to right direction

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Container>
!include <C4/C4_Component>

AddElementTag("Container,WebServer", $bgColor="#2e7cb8", $borderColor="#205680", $fontColor="#ffffff", $sprite="", $shadowing="", $borderStyle="solid")
AddElementTag("Component,Application", $bgColor="#cfe2f3", $borderColor="#909eaa", $fontColor="#1f1f1f", $sprite="", $shadowing="", $borderStyle="solid")
AddElementTag("Person,User", $bgColor="#0b5f8a", $borderColor="#074260", $fontColor="#ffffff", $sprite="", $shadowing="", $borderStyle="solid")
AddElementTag("Component,Infrastructure", $bgColor="#f4cccc", $borderColor="#aa8e8e", $fontColor="#1f1f1f", $sprite="", $shadowing="", $borderStyle="solid")
AddElementTag("Component,Domain", $bgColor="#d9ead3", $borderColor="#97a393", $fontColor="#1f1f1f", $sprite="", $shadowing="", $borderStyle="solid")
AddElementTag("Component,Interface", $bgColor="#fff2cc", $borderColor="#b2a98e", $fontColor="#1f1f1f", $sprite="", $shadowing="", $borderStyle="solid")

AddRelTag("Relationship", $textColor="#666666", $lineColor="#666666", $lineStyle = DashedLine())

AddBoundaryTag("Container,SPA", $bgColor="#ffffff", $borderColor="#0b4884", $fontColor="#0b4884", $shadowing="", $borderStyle="solid")

Person(User, "User", $descr="Performs calculations in a web browser, on desktop or mobile.", $tags="Person,User", $link="")

System_Boundary("SezzleCalculator_boundary", "Sezzle Calculator", $tags="Software System,Platform") {
  Container_Boundary("SezzleCalculator.SinglePageApplication_boundary", "Single-Page Application", $tags="Container,SPA") {
    Component(SezzleCalculator.SinglePageApplication.useCalculation, "useCalculation", $techn="React hook", $descr="Holds the calculation state: idle, loading, success or error.", $tags="Component,Application", $link="")
    Component(SezzleCalculator.SinglePageApplication.OperationCatalog, "Operation Catalog", $techn="TypeScript", $descr="The seven operations, their symbols and input labels.", $tags="Component,Domain", $link="")
    Component(SezzleCalculator.SinglePageApplication.InputValidation, "Input Validation", $techn="TypeScript", $descr="Accepts plain decimal numbers only; checks format, not math rules.", $tags="Component,Domain", $link="")
    Component(SezzleCalculator.SinglePageApplication.NumberFormatting, "Number Formatting", $techn="TypeScript", $descr="Writes expressions and results without float noise.", $tags="Component,Domain", $link="")
    Component(SezzleCalculator.SinglePageApplication.CalculatorAPIClient, "Calculator API Client", $techn="fetch", $descr="Calls the API with a 10 s timeout and turns Problem Details into user messages.", $tags="Component,Infrastructure", $link="")
    Component(SezzleCalculator.SinglePageApplication.App, "App", $techn="React component", $descr="Composes the calculator page.", $tags="Component,Interface", $link="")
    Component(SezzleCalculator.SinglePageApplication.CalculatorForm, "Calculator Form", $techn="React component", $descr="Number inputs, operation picker and per-field validation messages.", $tags="Component,Interface", $link="")
    Component(SezzleCalculator.SinglePageApplication.ResultPanel, "Result Panel", $techn="React component", $descr="Shows the result, the loading state or the API error.", $tags="Component,Interface", $link="")
  }

  Container(SezzleCalculator.WebApplication, "Web Application", $techn="nginx 1.28", $descr="Delivers the static content and the single-page application to the browser, and proxies /api and /docs to the API.", $tags="Container,WebServer", $link="")
}

Rel(User, SezzleCalculator.WebApplication, "Visits the calculator at", $techn="HTTP", $tags="Relationship", $link="")
Rel(User, SezzleCalculator.SinglePageApplication.CalculatorForm, "Types the numbers and picks the operation in", $techn="Web UI", $tags="Relationship", $link="")
Rel(User, SezzleCalculator.SinglePageApplication.ResultPanel, "Reads the result in", $techn="Web UI", $tags="Relationship", $link="")
Rel(SezzleCalculator.SinglePageApplication.App, SezzleCalculator.SinglePageApplication.CalculatorForm, "Renders", $techn="Function call", $tags="Relationship", $link="")
Rel(SezzleCalculator.SinglePageApplication.App, SezzleCalculator.SinglePageApplication.ResultPanel, "Renders", $techn="Function call", $tags="Relationship", $link="")
Rel(SezzleCalculator.SinglePageApplication.App, SezzleCalculator.SinglePageApplication.useCalculation, "Runs the calculations through", $techn="Function call", $tags="Relationship", $link="")
Rel(SezzleCalculator.SinglePageApplication.CalculatorForm, SezzleCalculator.SinglePageApplication.OperationCatalog, "Reads the operations and input labels from", $techn="Function call", $tags="Relationship", $link="")
Rel(SezzleCalculator.SinglePageApplication.CalculatorForm, SezzleCalculator.SinglePageApplication.InputValidation, "Validates the input before submitting with", $techn="Function call", $tags="Relationship", $link="")
Rel(SezzleCalculator.SinglePageApplication.ResultPanel, SezzleCalculator.SinglePageApplication.NumberFormatting, "Formats the expression and the result with", $techn="Function call", $tags="Relationship", $link="")
Rel(SezzleCalculator.SinglePageApplication.useCalculation, SezzleCalculator.SinglePageApplication.CalculatorAPIClient, "Requests the calculation from", $techn="Function call", $tags="Relationship", $link="")
Rel(SezzleCalculator.SinglePageApplication.CalculatorAPIClient, SezzleCalculator.WebApplication, "Sends POST /api/v1/{operation} to", $techn="JSON / HTTP", $tags="Relationship", $link="")

SHOW_LEGEND(true)
hide stereotypes
@enduml